{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug MCP Server",
      "program": "${workspaceFolder}/src/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "SA_CONSTRAINTS": "${workspaceFolder}/examples/quant/constraints.json"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Demo",
      "program": "${workspaceFolder}/examples/multi-agent/demo.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Demo (naive baseline)",
      "program": "${workspaceFolder}/examples/multi-agent/demo.js",
      "args": ["--naive"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
